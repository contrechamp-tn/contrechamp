# Copier ce fichier en .env puis l'adapter. Ne jamais publier le fichier .env.

# Moteur de langage : "local" (Ollama, par défaut, rien ne quitte l'ordinateur)
# ou "api" (fournisseur externe, seulement avec l'accord explicite de l'auteur).
CONTRECHAMP_MOTEUR=local

# Modèle ouvert utilisé en mode local (nom tel qu'il apparaît dans Ollama).
# À décider pendant le prototype : choix du modèle après les essais.
CONTRECHAMP_MODELE_LOCAL=

# Adresse du serveur Ollama local.
OLLAMA_URL=http://localhost:11434

# Mode API (facultatif) : modèle et clé du fournisseur.
# À décider pendant le prototype : fournisseur retenu.
CONTRECHAMP_MODELE_API=
CONTRECHAMP_CLE_API=

# Dossier du journal local (une ligne JSON par question posée).
CONTRECHAMP_DOSSIER_JOURNAL=./journal
